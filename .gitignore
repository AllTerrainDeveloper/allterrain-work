# This repository is a single plugin, not a WordPress install, so the usual
# WordPress.gitignore (which excludes /wp-admin, /wp-includes, uploads and so
# on) has nothing to match here and would only hide what it is for.

# Dependency trees. `vendor/` is dev tooling only — the plugin has no runtime
# PHP dependencies.
node_modules/
vendor/

# Output of the release packaging step.
dist/

# Built bundles are deliberately *not* ignored: this repo is installable as a
# plugin straight from a clone or a zip, and a plugin whose JavaScript has to be
# compiled before it runs is not installable.

.DS_Store
.phpunit.result.cache
*.log
